{
    "items": [
        {
            "name": "OmniView(相框)",
            "priority": 0,
            "items": [
                {
                    "name": "Register Device (注册设备)",
                    "priority": 0,
                    "if": "\"/mnt/us/OmniView/conf/registered.flag\" -f!",
                    "action": "bin/omniview.sh",
                    "params": "register",
                    "exitmenu": false,
                    "refresh": true
                },
                {
                    "name": "卸载 (Uninstall)",
                    "priority": 1,
                    "if": "\"/mnt/us/OmniView/conf/registered.flag\" -f!",
                    "action": "bin/omniview.sh",
                    "params": "uninstall",
                    "exitmenu": false,
                    "refresh": true,
                    "confirm": {
                        "title": "卸载 OmniView？",
                        "description": "将停止屏保/自动同步并还原系统屏保目录。下载缓存与日志保留。"
                    }
                },
                {
                    "name": "启动休眠壁纸 (Sleep Wallpaper)",
                    "priority": 2,
                    "if": "\"/mnt/us/OmniView/conf/registered.flag\" -f \"/mnt/us/OmniView/conf/ss_enabled\" -f! &&",
                    "action": "bin/omniview.sh",
                    "params": "start-screensaver",
                    "exitmenu": false,
                    "refresh": true
                },
                {
                    "name": "停止运行 (休眠壁纸)",
                    "priority": 3,
                    "if": "\"/mnt/us/OmniView/conf/registered.flag\" -f \"/mnt/us/OmniView/conf/ss_enabled\" -f &&",
                    "action": "bin/omniview.sh",
                    "params": "stop",
                    "exitmenu": false,
                    "refresh": true
                },
                {
                    "name": "Clear Cache (清除缓存)",
                    "priority": 4,
                    "if": "\"/mnt/us/OmniView/conf/registered.flag\" -f",
                    "action": "bin/omniview.sh",
                    "params": "clear-cache",
                    "exitmenu": false,
                    "refresh": false
                },
                {
                    "name": "Online Update (在线更新)",
                    "priority": 5,
                    "if": "\"/mnt/us/OmniView/conf/registered.flag\" -f",
                    "action": "bin/omniview.sh",
                    "params": "update",
                    "exitmenu": false,
                    "refresh": false
                }
            ]
        },
        {
            "name": "OmniBookShelf(书架)",
            "priority": 1,
            "if": "\"/mnt/us/OmniView/conf/registered.flag\" -f",
            "items": [
                {
                    "name": "Sync Now (立即同步)",
                    "priority": 0,
                    "if": "\"/mnt/us/OmniView/conf/registered.flag\" -f",
                    "action": "bin/omniview.sh",
                    "params": "sync",
                    "exitmenu": false,
                    "refresh": false
                },
                {
                    "name": "View Status (查看状态)",
                    "priority": 1,
                    "if": "\"/mnt/us/OmniView/conf/registered.flag\" -f",
                    "action": "bin/omniview.sh",
                    "params": "status",
                    "exitmenu": false,
                    "refresh": false
                },
                {
                    "name": "启用自动同步 (Auto-Sync)",
                    "priority": 2,
                    "if": "\"/mnt/us/OmniView/conf/registered.flag\" -f \"/mnt/us/ENABLE_BOOKSHELF_AUTOSTART\" -f! &&",
                    "action": "bin/omniview.sh",
                    "params": "enable-autostart",
                    "exitmenu": false,
                    "refresh": true
                },
                {
                    "name": "禁用自动同步 (Auto-Sync)",
                    "priority": 3,
                    "if": "\"/mnt/us/OmniView/conf/registered.flag\" -f \"/mnt/us/ENABLE_BOOKSHELF_AUTOSTART\" -f &&",
                    "action": "bin/omniview.sh",
                    "params": "disable-autostart",
                    "exitmenu": false,
                    "refresh": true
                }
            ]
        }
    ]
}
